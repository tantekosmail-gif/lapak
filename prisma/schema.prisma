generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  image           String?
  address         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  userType        UserTypeEnum @default(CUSTOMER) @map("user_type")
  orders          Order[]
  @@map("users")
}


model ProductCategories {
  id        Int      @id @default(autoincrement())
  name      String
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  products  Product[]
  @@map("product_categories")
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  price      Int
  regular_price Int 
  stock      Int      @default(0)
  sold       Int      @default(0)
  imageUrl   String?  @map("image_url")
  status     Status   @default(AKTIF)
  slug       String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  categoryId Int?              @map("category_id")
  category   ProductCategories? @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @map("order_number")
  customerId  Int         
  total       Int
  itemsCount  Int         @default(0) @map("items_count")
  status      OrderStatus @default(MENUNGGU)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  items       OrderItem[]
  customer    User @relation(fields:[customerId], references:[id], onDelete: Cascade)
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  quantity    Int      @default(1)
  price       Int
  subtotal    Int
  createdAt   DateTime @default(now()) @map("created_at")

  orderId     Int      @map("order_id")
  productId   Int      @map("product_id")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model StoreConfiguration{
  id Int @id @default(autoincrement())
  settings Json @default("{}")  
  @@map("store_configuraions")
}

enum OrderStatus {
  MENUNGGU
  MENUNGGU_PEMBATALAN
  DIPROSES
  DIKIRIM
  SELESAI
  DIBATALKAN
}

enum Status {
  AKTIF
  HABIS
  NONAKTIF
}

enum UserTypeEnum{
  CUSTOMER
  ADMIN
}