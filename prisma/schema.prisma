generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  image           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  @@map("users")
}


model ProductCategories {
  id        Int      @id @default(autoincrement())
  name      String
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("product_categories")
}